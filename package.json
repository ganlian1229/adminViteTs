{
    "name": "adminvitets",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "eslint": "npx eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
        "format": "npx prettier --write --ignore-path .prettierignore \"**/*.{js,ts,vue,scss}\"",
        "preview": "vite preview"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{js,ts,vue,scss}": [
            "npx eslint --fix",
            "npx prettier --write --ignore-path .prettierignore"
        ]
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.1",
        "axios": "^1.7.9",
        "element-plus": "^2.9.2",
        "lodash-es": "^4.17.21",
        "mitt": "^3.0.1",
        "pinia": "^2.3.0",
        "pinia-plugin-persist": "^1.0.0",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^18.19.48",
        "@typescript-eslint/parser": "^5.62.0",
        "@vitejs/plugin-vue": "^4.6.2",
        "@vue/eslint-config-prettier": "^7.1.0",
        "babel-eslint": "^10.1.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^8.10.0",
        "eslint-plugin-prettier": "^4.2.1",
        "eslint-plugin-vue": "^9.27.0",
        "husky": "^4.3.8",
        "lint-staged": "^12.1.7",
        "prettier": "^2.8.8",
        "rollup-plugin-visualizer": "^5.12.0",
        "sass": "^1.86.0",
        "terser": "^5.31.6",
        "typescript": "^4.9.5",
        "unplugin-auto-import": "^0.14.4",
        "unplugin-vue-components": "^0.25.2",
        "vite": "^4.5.3",
        "vite-plugin-style-import": "^2.0.0",
        "vue-tsc": "^1.8.27"
    },
    "engines": {
        "node": ">=18"
    }
}
